<style>
  :root {
    --paper: #F6F4EC;
    --ink: #1A2420;
    --rule: #DBD3BE;
    --ledger: #1F6E4C;
  }

  * { box-sizing: border-box; }

  html { scroll-behavior: smooth; }

  body {
    background-color: var(--paper);
    color: var(--ink);
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  h1, h2, h3, .font-display {
    font-family: 'Newsreader', Georgia, serif;
    letter-spacing: -0.01em;
  }

  ::selection { background: #1F6E4C; color: #F6F4EC; }

  /* Visible, deliberate focus ring — ledger green, offset like a highlighter mark */
  a:focus-visible, button:focus-visible, input:focus-visible, select:focus-visible, textarea:focus-visible {
    outline: 2px solid #1F6E4C;
    outline-offset: 3px;
    border-radius: 2px;
  }

  section { scroll-margin-top: 5rem; }

  /* -------- Skip link -------- */
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    background: #1A2420;
    color: #F6F4EC;
    padding: 0.75rem 1.25rem;
    z-index: 100;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.875rem;
  }
  .skip-link:focus { left: 1rem; top: 1rem; border-radius: 3px; }

  /* -------- Eyebrow label: sentence case, mono, small square mark -------- */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.8125rem;
    color: #49584C;
  }
  .eyebrow::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    background: #1F6E4C;
  }

  /* -------- Buttons -------- */
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: 'IBM Plex Sans', sans-serif;
    font-weight: 600;
    font-size: 0.9375rem;
    padding: 0.85rem 1.5rem;
    border-radius: 4px;
    transition: background-color 0.15s ease, border-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
    cursor: pointer;
    border: 1px solid transparent;
  }
  .btn-primary {
    background: #1F6E4C;
    color: #F6F4EC;
  }
  .btn-primary:hover { background: #154D35; }
  .btn-secondary {
    background: transparent;
    border-color: #1A2420;
    color: #1A2420;
  }
  .btn-secondary:hover { background: #1A2420; color: #F6F4EC; }
  .btn-block { width: 100%; }

  /* -------- Cards: flat, hairline, no shadow soup -------- */
  .card {
    background: #FFFFFF;
    border: 1px solid var(--rule);
    border-radius: 6px;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  .card:hover { border-color: #C7BC9E; }

  .rule-top { border-top: 1px solid var(--rule); }
  .rule-bottom { border-bottom: 1px solid var(--rule); }

  /* -------- Stamp badge: literal rubber-stamp graphic, used sparingly -------- */
  .stamp {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.3rem 0.65rem;
    border: 1.5px solid currentColor;
    border-radius: 3px;
    transform: rotate(-2.5deg);
    box-shadow: 0 0 0 2px #FFFFFF, 0 0 0 3px currentColor;
  }
  .stamp-verified { color: #1F6E4C; }
  .stamp-draft { color: #9C3B26; }

  /* -------- Receipt / ledger ticket visual (signature element) -------- */
  .receipt {
    background: #FFFFFF;
    border: 1px solid var(--rule);
    position: relative;
    transform: rotate(-0.6deg);
  }
  .receipt::before, .receipt::after {
    content: '';
    position: absolute;
    left: 0; right: 0;
    height: 10px;
    background-image: radial-gradient(circle, #F6F4EC 5px, transparent 5.5px);
    background-size: 16px 16px;
    background-position: -4px center;
  }
  .receipt::before { top: -5px; }
  .receipt::after { bottom: -5px; }

  /* -------- Ledger banding: subtle green-bar paper echo, used only on data tables -------- */
  .ledger-band {
    background-image: repeating-linear-gradient(
      to bottom,
      #FFFFFF 0px,
      #FFFFFF 36px,
      #F1F6F3 36px,
      #F1F6F3 72px
    );
  }

  /* -------- Reveal: single, restrained scroll-in -------- */
  .reveal {
    opacity: 0;
    transform: translateY(14px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .reveal.is-visible { opacity: 1; transform: translateY(0); }

  @media (prefers-reduced-motion: reduce) {
    .reveal { opacity: 1 !important; transform: none !important; transition: none !important; }
    html { scroll-behavior: auto; }
  }

  /* -------- Nav -------- */
  #navbar { transition: box-shadow 0.2s ease, border-color 0.2s ease; }
  #navbar.is-scrolled { box-shadow: 0 1px 0 var(--rule); }

  .nav-link {
    font-size: 0.9375rem;
    color: #49584C;
    transition: color 0.15s ease;
  }
  .nav-link:hover { color: #1A2420; }

  /* -------- Slider styling -------- */
  input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    height: 3px;
    background: var(--rule);
    border-radius: 999px;
  }
  input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #1F6E4C;
    border: 2px solid #FFFFFF;
    box-shadow: 0 0 0 1px #1F6E4C;
    cursor: pointer;
  }
  input[type="range"]::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #1F6E4C;
    border: 2px solid #FFFFFF;
    box-shadow: 0 0 0 1px #1F6E4C;
    cursor: pointer;
  }

  /* -------- Form inputs -------- */
  .field {
    width: 100%;
    background: #FFFFFF;
    border: 1px solid var(--rule);
    border-radius: 4px;
    padding: 0.75rem 1rem;
    font-size: 0.9375rem;
    color: #1A2420;
  }
  .field:focus { border-color: #1F6E4C; }
  .field::placeholder { color: #A8A08C; }

  /* -------- Count-up numerals -------- */
  .count-target { display: inline-block; }

  /* -------- Query tabs -------- */
  .query-btn {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.75rem;
    padding: 0.5rem 0.85rem;
    border-radius: 3px;
    border: 1px solid var(--rule);
    color: #49584C;
    background: #FFFFFF;
    transition: all 0.15s ease;
    white-space: nowrap;
  }
  .query-btn.active {
    background: #1A2420;
    border-color: #1A2420;
    color: #F6F4EC;
  }

  /* Utility */
  .measure { max-width: 62ch; }
  .mono { font-family: 'IBM Plex Mono', monospace; }
</style>
</head>
